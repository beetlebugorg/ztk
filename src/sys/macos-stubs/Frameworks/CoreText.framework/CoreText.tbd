--- !tapi-tbd
# A text stub for the Zig linker, written for ztk: the install name and the
# symbols that ztk uses, so that a macOS program links on any host.
# SPDX-License-Identifier: BSD-2-Clause
tbd-version:     4
targets:         [ x86_64-macos, arm64-macos, arm64e-macos ]
install-name:    '/System/Library/Frameworks/CoreText.framework/Versions/A/CoreText'
current-version: 1
exports:
  - targets:     [ x86_64-macos, arm64-macos, arm64e-macos ]
    symbols:     [ _CTFontGetUnitsPerEm, _CTFontGetSize, _CTFontGetAscent, _CTFontGetDescent,
                   _CTFontGetLeading, _CTFontGetGlyphsForCharacters, _CTFontGetAdvancesForGlyphs,
                   _CTFontGetBoundingRectsForGlyphs, _CTFontDrawGlyphs,
                   _CTLineCreateWithAttributedString, _CTLineGetGlyphRuns,
                   _CTLineGetTypographicBounds, _CTRunGetGlyphCount, _CTRunGetGlyphs,
                   _CTRunGetPositions, _CTRunGetStringIndices, _CTRunGetAttributes ]
...
