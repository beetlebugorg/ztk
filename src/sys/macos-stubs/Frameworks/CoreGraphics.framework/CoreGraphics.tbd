--- !tapi-tbd
# A text stub for the Zig linker, written for ztk: the install name and the
# symbols that ztk uses, so that a macOS program links on any host.
# SPDX-License-Identifier: BSD-2-Clause
tbd-version:     4
targets:         [ x86_64-macos, arm64-macos, arm64e-macos ]
install-name:    '/System/Library/Frameworks/CoreGraphics.framework/Versions/A/CoreGraphics'
current-version: 1
exports:
  - targets:     [ x86_64-macos, arm64-macos, arm64e-macos ]
    symbols:     [ _kCGColorSpaceSRGB, _CGColorSpaceCreateWithName, _CGColorSpaceRelease,
                   _CGColorSpaceCreateDeviceGray, _CGBitmapContextCreate, _CGContextRelease,
                   _CGContextSetGrayFillColor, _CGContextTranslateCTM, _CGContextScaleCTM,
                   _CGContextSetShouldSmoothFonts, _CGContextSetAllowsFontSubpixelPositioning,
                   _CGContextSetShouldSubpixelPositionFonts, _CGContextSetShouldSubpixelQuantizeFonts ]
...
