# Text files are LF in the repository and in each checkout, also on
# Windows, so embedded text, golden outputs, and scripts are the same
# bytes on each platform.
* text=auto eol=lf

# Binary files: no line end conversion and no text diff.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.wasm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.pdf binary
